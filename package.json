{
  "name": "astro-react-cloudflare",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro build && wrangler dev",
    "astro": "astro",
    "check": "astro check --minimumFailingSeverity hint",
    "lint:design": "design.md lint DESIGN.md",
    "check:tokens": "node scripts/check-design-tokens.mjs",
    "check:css": "node scripts/check-stylesheets.mjs",
    "i18n:check": "node scripts/i18n-check.mjs",
    "check:agents": "node scripts/check-agent-files.mjs dist/client",
    "check:perf": "node scripts/check-perf-budget.mjs dist/client",
    "lighthouse": "lhci autorun",
    "verify": "pnpm run check:tokens && pnpm run lint:design && pnpm run check:css && pnpm run i18n:check && pnpm run check && pnpm run build && pnpm run check:agents && pnpm run check:perf"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "packageManager": "pnpm@12.8.1",
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.3",
    "@astrojs/react": "^7.1.2",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@gutenye/astro-i18next": "^1.0.9",
    "astro": "^7.4.4",
    "i18next": "^26.7.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@google/design.md": "^0.4.0",
    "@lhci/cli": "^0.15.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "node-html-markdown": "^2.0.0",
    "node-html-parser": "^9.0.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "wrangler": "^4.156.1"
  }
}
